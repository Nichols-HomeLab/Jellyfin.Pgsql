{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "timezone": "America/New_York",
  "schedule": [
    "after 2am and before 6am"
  ],
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 8,
  "rangeStrategy": "replace",
  "automerge": false,
  "ignoreTests": false,
  "docker": {
    "pinDigests": true
  },
  "packageRules": [
    {
      "description": "Group non-major container updates for manual review",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ],
      "groupName": "container image updates",
      "automerge": false,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Never automatically merge major releases",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Group GitHub Actions dependencies",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "CI action updates",
      "automerge": false
    },
    {
      "description": "Hold database upgrades for review",
      "matchPackageNames": [
        "postgres",
        "timescale/timescaledb"
      ],
      "automerge": false
    }
  ]
}
